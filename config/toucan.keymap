/*
 * Miryoku-Layout (QWERTZ, Schweizer Layout de_CH) fuer beekeeb Toucan (42 Tasten)
 *
 * WICHTIG: Am Computer muss das Tastaturlayout "Deutsch (Schweiz)" eingestellt sein.
 * ZMK sendet Tastenpositionen (US-Scancodes), das Betriebssystem macht daraus Zeichen.
 * Deshalb sind unten z.B. Y und Z vertauscht und Symbole mit LS()/RA() gebaut.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define NAV   1
#define MEDIA 2
#define NUM   3
#define SYM   4
#define FUN   5

/* --- Schweizer Layout: Zeichen -> zu sendender Keycode --- */
#define CH_UE    LBKT              /* ü  (Shift: è) */
#define CH_OE    SEMI              /* ö  (Shift: é) */
#define CH_AE    SQT               /* ä  (Shift: à) */
#define CH_APOS  MINUS             /* '  */
#define CH_MINS  FSLH              /* -  */
#define CH_UNDS  LS(FSLH)          /* _  */
#define CH_DLLR  BSLH              /* $  */
#define CH_EXLM  LS(RBKT)          /* !  */
#define CH_PLUS  LS(N1)            /* +  */
#define CH_DQUO  LS(N2)            /* "  */
#define CH_ASTR  LS(N3)            /* *  */
#define CH_PERC  LS(N5)            /* %  */
#define CH_AMPR  LS(N6)            /* &  */
#define CH_LPRN  LS(N8)            /* (  */
#define CH_RPRN  LS(N9)            /* )  */
#define CH_EQL   LS(N0)            /* =  */
#define CH_COLN  LS(DOT)           /* :  */
#define CH_SCLN  LS(COMMA)         /* ;  */
#define CH_AT    RA(N2)            /* @  */
#define CH_HASH  RA(N3)            /* #  */
#define CH_PIPE  RA(N7)            /* |  */
#define CH_LBRC  RA(LBKT)          /* [  */
#define CH_RBRC  RA(RBKT)          /* ]  */
#define CH_LCBR  RA(SQT)           /* {  */
#define CH_RCBR  RA(BSLH)          /* }  */
#define CH_BSLS  RA(NON_US_BSLASH) /* \  */
#define CH_TILD  RA(EQUAL)         /* ~  (je nach OS Tottaste: danach Space) */

/* Undo/Redo: Ctrl + Buchstabe z bzw. y (Scancodes vertauscht) */
#define CH_UNDO  LC(Y)
#define CH_REDO  LC(Z)

/ {
    behaviors {
        /* Home-Row-Mods, linke Hand: loest nur mit Tasten der rechten Hand aus */
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        /* Home-Row-Mods, rechte Hand: loest nur mit Tasten der linken Hand aus */
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp ESC   &kp Q          &kp W          &kp E           &kp R           &kp T    &kp Y  &kp U          &kp I          &kp O         &kp P              &kp CH_UE
                &kp TAB   &hml LGUI A    &hml LALT S    &hml LCTRL D    &hml LSHFT F    &kp G    &kp H  &hmr RSHFT J   &hmr RCTRL K   &hmr RALT L   &hmr RGUI CH_APOS  &kp CH_OE
                &kp LSHFT &kp Z          &kp X          &kp C           &kp V           &kp B    &kp N  &kp M          &kp COMMA      &kp DOT       &kp CH_MINS        &kp CH_AE
                                         &lt MEDIA ESC  &lt NAV SPACE   &kp TAB                  &lt SYM RET  &lt NUM BSPC  &lt FUN DEL
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &none &none     &none     &none      &none       &none    &kp CH_REDO  &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp CH_UNDO  &none
                &none &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT   &none    &kp CAPS     &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT    &none
                &none &none     &none     &none      &none       &none    &kp INS      &kp HOME   &kp PG_DN  &kp PG_UP  &kp END      &none
                                &none     &none      &none                &kp RET      &kp BSPC   &kp DEL
            >;
        };

        media {
            display-name = "MEDIA";
            bindings = <
                &none &none     &none     &none      &none       &none    &bt BT_CLR  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &none
                &none &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT   &none    &none       &kp C_PREV     &kp C_VOL_DN   &kp C_VOL_UP  &kp C_NEXT    &none
                &none &none     &none     &none      &none       &none    &none       &none          &none          &none         &none         &none
                                &none     &none      &none                &kp C_STOP  &kp C_PP       &kp C_MUTE
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
                &none &kp CH_LBRC  &kp N7  &kp N8  &kp N9  &kp CH_RBRC    &none  &none       &none       &none      &none      &none
                &none &kp CH_SCLN  &kp N4  &kp N5  &kp N6  &kp CH_EQL     &none  &kp RSHFT  &kp RCTRL   &kp RALT   &kp RGUI   &none
                &none &kp CH_BSLS  &kp N1  &kp N2  &kp N3  &kp CH_DLLR    &none  &none       &none       &none      &none      &none
                                   &kp DOT &kp N0  &kp CH_MINS            &none  &none       &none
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &none &kp CH_LCBR  &kp CH_AMPR  &kp CH_ASTR  &kp CH_LPRN  &kp CH_RCBR    &none  &none       &none       &none      &none      &none
                &none &kp CH_COLN  &kp CH_DLLR  &kp CH_PERC  &kp CH_DQUO  &kp CH_PLUS    &none  &kp RSHFT  &kp RCTRL   &kp RALT   &kp RGUI   &none
                &none &kp CH_TILD  &kp CH_EXLM  &kp CH_AT    &kp CH_HASH  &kp CH_PIPE    &none  &none       &none       &none      &none      &none
                                   &kp CH_LPRN  &kp CH_RPRN   &kp CH_UNDS                 &none  &none       &none
            >;
        };

        fun {
            display-name = "FUN";
            bindings = <
                &studio_unlock &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN         &none  &none       &none       &none      &none      &none
                &none          &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK          &none  &kp RSHFT  &kp RCTRL   &kp RALT   &kp RGUI   &none
                &none          &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK   &none  &none       &none       &none      &none      &none
                                        &kp K_APP  &kp SPACE  &kp TAB              &none  &none       &none
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
